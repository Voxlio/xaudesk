# ---------------------------------------------------------------------------
# XAU Desk environment. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# XAU/USD live OHLC source: "twelvedata" only in the application runtime.
# The fixture adapter is used directly in unit tests and is never an app fallback.
PRICE_ADAPTER=twelvedata

# Twelve Data (https://twelvedata.com) — free tier is 8 requests/minute.
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOL=XAU/USD

# ForexFactory public calendar feed. Public JSON, no key required.
# Never scrape the HTML site.
FOREX_FACTORY_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_CACHE_TTL_SECONDS=1800

# Protect scheduled jobs at /api/cron/daily and /api/cron/outcomes.
# Configure the same value in the deployment platform's environment settings.
CRON_SECRET=

# Protect operator writes at PUT /api/settings (equity, risk %, lot step/min).
# A SEPARATE value from CRON_SECRET: this one is typed into the settings form in a
# browser, so it travels further than the server-to-server cron token. Leaving it
# unset does not open the route — it refuses every save with a 503.
ADMIN_SECRET=

# Live macro inputs: UUP via Twelve Data, with FRED DTWEXBGS fallback;
# US 10-year yield from FRED DGS10. No fixture substitution on live mode.
MACRO_ADAPTER=live
FRED_API_KEY=

# Prisma / SQLite
DATABASE_URL="file:./prisma/dev.db"

# Equity must be the USD value of the deposit, not the terminal's cent display.
# For example, $100 USD is entered as 100 and displays as 10,000 account cents.
ACCOUNT_EQUITY_USD=
ACCOUNT_RISK_PERCENT=1

# Confirm these against the XAUUSD symbol specification in your HFM Cent account.
ACCOUNT_CENT_LOT_STEP=0.01
ACCOUNT_CENT_MIN_LOT=0.01
